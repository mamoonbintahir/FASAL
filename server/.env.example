# Copy to .env (never commit .env). All values are optional in development.
PORT=8080
APP_ENV=development            # production disables dev-only OTP echo
JWT_SECRET=change-me-to-a-long-random-string
MONGODB_URI=mongodb://localhost:27017/fasal   # or mongodb+srv://user:pass@cluster.mongodb.net/fasal
WEATHER_PROVIDER=openmeteo     # openmeteo | sample
CORS_ORIGINS=*
